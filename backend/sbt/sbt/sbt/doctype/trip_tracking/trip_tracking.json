{
 "doctype": "DocType",
 "name": "Trip Tracking",
 "module": "SBT",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "quick_entry": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "booking",
   "fieldtype": "Link",
   "label": "Booking",
   "options": "Booking",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "driver",
   "fieldtype": "Link",
   "label": "Driver",
   "options": "Driver",
   "fetch_from": "booking.driver",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "truck",
   "fieldtype": "Link",
   "label": "Truck",
   "options": "Truck",
   "fetch_from": "booking.truck",
   "read_only": 1
  },
  {
   "fieldname": "pickup_location",
   "fieldtype": "Data",
   "label": "Pickup Location",
   "fetch_from": "booking.from_location",
   "read_only": 1
  },
  {
   "fieldname": "destination",
   "fieldtype": "Data",
   "label": "Destination",
   "fetch_from": "booking.to_location",
   "read_only": 1
  },
  {
   "fieldname": "current_location",
   "fieldtype": "Data",
   "label": "Current Location",
   "in_list_view": 1
  },
  {
   "fieldname": "trip_status",
   "fieldtype": "Select",
   "label": "Trip Status",
   "options": "Assigned\nAccepted\nPickup\nIn Transit\nDelivered\nCompleted",
   "default": "Assigned",
   "in_list_view": 1
  },
  {
   "fieldname": "last_updated",
   "fieldtype": "Datetime",
   "label": "Last Updated",
   "read_only": 1
  },
  {
   "fieldname": "estimated_arrival",
   "fieldtype": "Datetime",
   "label": "Estimated Arrival"
  }
 ],
 "permissions": [
  {
   "role": "SBT Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "SBT Agent",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1
  },
  {
   "role": "SBT Customer",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1
  },
  {
   "role": "SBT Truck Owner",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1
  },
  {
   "role": "SBT Driver",
   "read": 1,
   "write": 1,
   "create": 0,
   "delete": 0,
   "report": 1
  }
 ],
 "autoname": "format:TRK-{#####}"
}
