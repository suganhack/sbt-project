{
 "doctype": "DocType",
 "name": "Customer Advance",
 "module": "SBT",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "quick_entry": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "booking",
   "fieldtype": "Link",
   "label": "Booking",
   "options": "Booking",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "fetch_from": "booking.customer",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_date",
   "fieldtype": "Datetime",
   "label": "Payment Date",
   "default": "Today"
  },
  {
   "fieldname": "payment_mode",
   "fieldtype": "Select",
   "label": "Payment Mode",
   "options": "Cash\nUPI\nBank Transfer\nCard",
   "reqd": 1
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference No"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nPaid",
   "default": "Paid",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "SBT Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "SBT Agent",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1
  },
  {
   "role": "SBT Customer",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "report": 1
  }
 ],
 "autoname": "format:CADV-{#####}"
}
