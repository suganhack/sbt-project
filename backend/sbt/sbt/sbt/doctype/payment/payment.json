{
 "doctype": "DocType",
 "name": "Payment",
 "module": "SBT",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "quick_entry": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "booking",
   "fieldtype": "Link",
   "label": "Booking",
   "options": "Booking",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_type",
   "fieldtype": "Select",
   "label": "Payment Type",
   "options": "Customer Advance\nCustomer Balance\nDriver Advance\nDriver Settlement",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "payment_date",
   "fieldtype": "Datetime",
   "label": "Payment Date",
   "default": "Now"
  },
  {
   "fieldname": "payment_mode",
   "fieldtype": "Select",
   "label": "Payment Mode",
   "options": "Cash\nUPI\nBank Transfer\nCard"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference No"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nCompleted\nFailed",
   "default": "Completed",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "SBT Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "SBT Agent",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "report": 1
  },
  {
   "role": "SBT Customer",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1
  }
 ],
 "autoname": "format:PAY-{#####}"
}
